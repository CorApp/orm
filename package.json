{
  "name": "@corapp/orm",
  "description": "ORM for the database in TursoTech Drizzle",
  "version": "2.3.6",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    "node": {
      "module": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs"
    },
    "default": "./dist/index.js"
  },
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsup",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "migrate:saas": "bun migrate-saas.ts"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "author": {
    "name": "CarmeloCampos",
    "email": "hola@carmelocampos.com"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.43.1",
    "uuid": "^11.1.1",
    "zod": "^3.25.76"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CorApp/orm.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  }
}
